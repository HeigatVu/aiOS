# --- SECURE WORKSPACE CONFIGS & PRIVATE DATA ---

# Exclude sensitive agent API keys, secure configs, and backups
agent-configs/*
!agent-configs/.gitkeep

# Exclude heavy audio datasets and large binary archives
data/*
!data/.gitkeep

# Exclude AI agent-generated outputs and results
outputs/*
!outputs/.gitkeep

# Exclude user working-space scripts and codes (only track the directory)
working-space/*
!working-space/.gitkeep

# Exclude persistent caching folders inside sidecar-ui
sidecar-ui/ml-env/*
!sidecar-ui/ml-env/.gitkeep
sidecar-ui/uv-cache/*
!sidecar-ui/uv-cache/.gitkeep
sidecar-ui/conda-cache/*
!sidecar-ui/conda-cache/.gitkeep


# --- GENERAL EXCLUSIONS ---
.uv-cache/
.streamlit/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.DS_Store

.env

how-to-use.md