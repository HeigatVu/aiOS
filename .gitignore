# --- SECURE WORKSPACE CONFIGS & PRIVATE DATA ---

# Exclude persistent agent configs, caches, and ML environments
persistent/*
!persistent/.gitkeep

# Exclude heavy audio datasets and large binary archives
data/*
!data/.gitkeep

# Exclude AI agent-generated outputs and results
outputs/*
!outputs/.gitkeep

# Exclude user working-space scripts and codes (only track the directory)
working-space/*
!working-space/.gitkeep


# --- GENERAL EXCLUSIONS ---
.uv-cache/
.streamlit/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.DS_Store

.env

how-to-use.md

agent-configs/*

prompt-to-fix.md

.claude
.antigravitycli