# Source the host's original .zshrc to leverage all user settings, aliases, and theme
if [ -f /home/ai_user/.zshrc_host ]; then
    source /home/ai_user/.zshrc_host
fi

# Override Conda paths to ensure the container's Python environment is utilized
source /home/ai_user/miniconda3/etc/profile.d/conda.sh
export PATH="/home/ai_user/miniconda3/bin:$PATH"
eval "$(/home/ai_user/miniconda3/bin/conda shell.zsh hook)"
conda activate ai-baseline

# Auto-start Hermes dashboard proxy (exposes port 9119 outside Docker)
# Fallback only — entrypoint starts it first. Check PID file to avoid race.
if ! kill -0 "$(cat /tmp/hermes-proxy.pid 2>/dev/null)" 2>/dev/null && \
   ! pgrep -f "dashboard-proxy.mjs" > /dev/null 2>&1; then
  node /config-file/hermes/dashboard-proxy.mjs >> ~/.hermes/logs/dashboard-proxy.log 2>&1 &
  disown
fi

# Show service status on every new shell
echo ""
python3 /config-file/system-config/service_health.py
